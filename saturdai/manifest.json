{
  "manifest_version": 3,
  "name": "Saturdai",
  "version": "1.0.0",
  "description": "A Chrome extension for generating responses on social media platforms",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.x.com/*",
    "*://*.x.com/*",
    "*://*.linkedin.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.x.com/*",
        "*://*.x.com/*",
        "*://*.linkedin.com/*"
      ],
      "js": [
        "content-scripts/platforms.js",
        "content-scripts/content-script.js"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": [
        "*://*.x.com/*",
        "*://*.x.com/*",
        "*://*.linkedin.com/*"
      ]
    }
  ]
} 